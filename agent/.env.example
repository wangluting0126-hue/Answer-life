# 答案之书 Agent 配置。复制到 ~/.answerlife/.env（或运行 answerlife setup 自动生成）。

# ── 模型 ──────────────────────────────────────────────
# anthropic / deepseek / openai（任何兼容 OpenAI 接口的服务）/ mock（不联网，测试用）
AI_PROVIDER=anthropic
# 留空时读取 `ant auth login` 的登录信息
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low / medium / high：聊天默认 low（快、省）；觉得出页不够细致时调到 medium
ANTHROPIC_EFFORT=low

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# 硅基流动、通义、Kimi、智谱、本机 Ollama……都走这一种；模型必须支持工具调用
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# 主模型连不上 / Key 失效时切到哪一家（要和 AI_PROVIDER 不同，且那一家的 Key 已配好）
AI_FALLBACK=

# ── 服务 ──────────────────────────────────────────────
# 默认只监听本机。情感对话很私密，不要直接暴露到公网
HOST=127.0.0.1
PORT=8020
TIMEZONE=Asia/Shanghai
# IM 里给出答案页链接时用的地址；留空用 http://localhost:PORT（只在本机能打开）
PUBLIC_URL=

# ── 手机 IM（都不需要公网地址）──────────────────────────
# Telegram：找 @BotFather 创建机器人
TELEGRAM_BOT_TOKEN=
# 飞书：企业自建应用，事件订阅选“长连接”，订阅 im.message.receive_v1；需 uv sync --extra feishu
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 钉钉：企业内部应用机器人，Stream 模式；需 uv sync --extra dingtalk
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
